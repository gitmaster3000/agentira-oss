meta {
  name: 06 Get agent shape
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/forge/agents/{{oc_agent_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

script:pre-request {
  if (!bru.getVar("oc_agent_id")) {
    bru.runner.skipRequest();
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.name: isDefined
}

docs {
  Verifies agent detail includes identity fields product UI relies on.
}
