meta {
  name: 03 Create frontend-shaped task
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/tasks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "project_id": "{{oc_project_id}}",
    "title": "IT: new task popup loses work on click-outside",
    "description": "Bruno seed task for OpenClaw multi-repo desk scenarios (frontend UI).",
    "status": "todo",
    "priority": "high",
    "tags": ["openclaw", "integration"]
  }
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const b = res.getBody();
    bru.setVar("oc_task_id", b.id);
    bru.setVar("oc_task_key", b.key || "");
  }
}

assert {
  res.status: in [200, 201]
  res.body.id: isDefined
  res.body.title: isDefined
}

docs {
  Creates a real task row the same way the product does. Used for runs/messages scopes.
}
