meta {
  name: Upload Attachment
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/tasks/{{_rest_tid}}/attachments
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(fixtures/preview.md)
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}

vars:post-response {
  _rest_aid: res.body.id
}
