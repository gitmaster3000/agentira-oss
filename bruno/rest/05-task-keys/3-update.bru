meta {
  name: Update Task by Key
  type: http
  seq: 3
}

patch {
  url: {{base_url}}/api/tasks/{{_key_task_key}}
  body: json
  auth: none
}

body:json {
  {
    "title": "Task Key Test Updated",
    "actor": "admin"
  }
}

assert {
  res.status: eq 200
  res.body.key: eq {{_key_task_key}}
  res.body.title: eq "Task Key Test Updated"
}
