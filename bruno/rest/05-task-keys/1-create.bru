meta {
  name: Create Task with Key
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/tasks
  body: json
  auth: none
}

body:json {
  {
    "project_id": "{{_rest_pid}}",
    "title": "Task Key Test",
    "description": "Verify Jira-style key is generated",
    "status": "backlog",
    "priority": "medium",
    "actor": "admin"
  }
}

assert {
  res.status: eq 200
  res.body.key: isDefined
  res.body.key: matches [A-Z0-9]+-\d+
  res.body.id: isDefined
}

vars:post-response {
  _key_task_key: res.body.key
  _key_task_id: res.body.id
}
