meta {
  name: "9-Handshake (Streamable HTTP)"
  type: "http"
  seq: 9
}

post {
  url: {{baseUrl}}/mcp
  body: json
}

headers {
  Authorization: Bearer {{apiKey}}
  Accept: application/json, text/event-stream
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "clientInfo": {
        "name": "bruno-integration-test",
        "version": "2.0.0"
      },
      "protocolVersion": "2025-06-18",
      "capabilities": {}
    }
  }
}

script:post-response {
  const sessionId = res.headers['mcp-session-id'];
  if (sessionId) {
    bru.setVar("sessionId", sessionId);
  }
}

tests {
  test("Handshake returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains result", function() {
    expect(res.body.result).to.be.an('object');
  });

  test("Server identifies as AgentIRA", function() {
    expect(res.body.result.serverInfo.name).to.equal("AgentIRA");
  });

  test("Server provides tools capability", function() {
    expect(res.body.result.capabilities.tools).to.be.an('object');
  });
}
