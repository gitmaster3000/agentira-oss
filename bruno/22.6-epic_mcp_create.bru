meta {
  name: "22.6-Epic MCP Create"
  type: "http"
  seq: 22
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 222,
    "method": "tools/call",
    "params": {
      "name": "create_epic",
      "arguments": {
        "project_id": "{{new_project_id}}",
        "title": "MCP Created Epic",
        "description": "Epic from MCP tool",
        "color": "#4caf50"
      }
    }
  }
}

tests {
  test("MCP create_epic successful", function() {
    expect(res.status).to.equal(200);
    const text = res.body.result.content[0].text;
    expect(text).to.contain("MCP Created Epic");
    expect(text).to.contain("#4caf50");
  });
}
