meta {
  name: "1.5-VerifyIdentity"
  type: "http"
  seq: 1.5
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 16,
    "method": "tools/call",
    "params": {
      "name": "get_me",
      "arguments": {}
    }
  }
}

tests {
  test("Verify identity successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result).to.be.an('object');
    expect(res.body.result.content[0].text).to.contain("Client ID:");
    expect(res.body.result.content[0].text).to.contain("abc");
  });
}
