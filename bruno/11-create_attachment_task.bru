meta {
  name: "11-Create Attachment Task"
  type: "http"
  seq: 11
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 11,
    "method": "tools/call",
    "params": {
      "name": "create_task",
      "arguments": {
        "project_id": "{{attachProjectId}}",
        "title": "Task for attachment testing"
      }
    }
  }
}

tests {
  test("Attachment task created", function() {
    expect(res.status).to.equal(200);
    const text = res.body.result.content[0].text;
    const task = JSON.parse(text);
    bru.setVar("attachTaskId", task.id);
  });
}
