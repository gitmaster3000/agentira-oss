meta {
  name: "1-Initialize"
  type: "http"
  seq: 1
}

post {
  url: {{baseUrl}}/mcp
  body: json
}

headers {
  Authorization: Bearer {{apiKey}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "clientInfo": {
        "name": "bruno-integration-test",
        "version": "1.0.0"
      },
      "protocolVersion": "2025-06-18",
      "capabilities": {}
    }
  }
}

script:post-response {
  // Capture session ID from headers or body
  const sessionId = res.headers['mcp-session-id'];
  if (sessionId) {
    bru.setVar("sessionId", sessionId);
  }
}

tests {
  test("Initialize successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result).to.be.an('object');
  });
}
