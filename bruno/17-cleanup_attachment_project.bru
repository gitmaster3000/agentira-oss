meta {
  name: "17-Cleanup Attachment Project"
  type: "http"
  seq: 99
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 17,
    "method": "tools/call",
    "params": {
      "name": "delete_project",
      "arguments": {
        "project_id": "{{attachProjectId}}"
      }
    }
  }
}

tests {
  test("Attachment project cleaned up", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result.content[0].text).to.contain("true");
  });
}
