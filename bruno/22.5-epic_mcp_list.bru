meta {
  name: "22.5-Epic MCP List"
  type: "http"
  seq: 22
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 221,
    "method": "tools/call",
    "params": {
      "name": "list_epics",
      "arguments": {
        "project_id": "{{new_project_id}}"
      }
    }
  }
}

tests {
  test("MCP list_epics returns results", function() {
    expect(res.status).to.equal(200);
    const text = res.body.result.content[0].text;
    expect(text).to.contain("Updated Epic Title");
  });
}
