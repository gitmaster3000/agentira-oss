meta {
  name: 27-Task Key MCP
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 27,
    "method": "tools/call",
    "params": {
      "name": "get_task",
      "arguments": {
        "task_id": "{{task_key}}"
      }
    }
  }
}

tests {
  test("MCP get_task by key returns correct task", function() {
    expect(res.status).to.equal(200);
    const text = res.body.result.content[0].text;
    expect(text).to.contain("Task Key Test");
  });
}
