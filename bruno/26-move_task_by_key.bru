meta {
  name: 26-Move Task by Key
  type: http
  seq: 26
}

post {
  url: {{base_url}}/api/tasks/{{task_key}}/move
  body: json
  auth: none
}

body:json {
  {
    "status": "todo",
    "actor": "admin"
  }
}

assert {
  res.status: eq 200
  res.body.key: eq {{task_key}}
  res.body.status: eq todo
}
