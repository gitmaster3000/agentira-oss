meta {
  name: "Proxy Shim Step 2: RPC Auth (POST /messages/)"
  type: "http"
  seq: 11
}

post {
  url: {{baseUrl}}/messages/
  body: json
}

headers {
  Authorization: Bearer {{apiKey}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "clientInfo": {
        "name": "bruno-shim-tester",
        "version": "1.0.0"
      },
      "protocolVersion": "2025-06-18",
      "capabilities": {}
    }
  }
}

tests {
  test("Endpoint exists (responds with status)", function() {
    // It should NOT be 404 or 405
    expect(res.status).to.be.oneOf([200, 400]);
  });

  test("Missing Session ID handled correctly (400)", function() {
    // Since we didn't provide ?sessionId=...
    // The MCP app returns 400 Bad Request
    expect(res.status).to.equal(400);
  });

  test("Error message is descriptive", function() {
    // We expect some indication that the session ID is missing if possible
    // Note: FastMCP might just return 400 without body for this specific case
  });
}
