meta {
  name: "4-CreateTask"
  type: "http"
  seq: 4
}

post {
  url: {{baseUrl}}/sse
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 4,
    "method": "tools/call",
    "params": {
      "name": "create_task",
      "arguments": {
        "project_id": "{{projectId}}",
        "title": "Integration Test Task",
        "description": "Checking tool expansion",
        "priority": "high"
      }
    }
  }
}

script:post-response {
  if (res.body.result && res.body.result.content && res.body.result.content[0].text) {
     try {
       const text = res.body.result.content[0].text.replace(/'/g, '"');
       const data = JSON.parse(text);
       if (data && data.id) {
         bru.setVar("taskId", data.id);
       }
     } catch (e) {
     }
  }
}

tests {
  test("Create task successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result.content[0].text).to.contain("Integration Test Task");
  });
}
