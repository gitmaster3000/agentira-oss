meta {
  name: Get Notifications
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 80,
    "method": "tools/call",
    "params": {
      "name": "get_notifications",
      "arguments": {
        "unread_only": false
      }
    }
  }
}

tests {
  test("Get notifications responds successfully", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result).to.be.an('object');
    expect(res.body.result.isError).to.not.equal(true);
  });
}
