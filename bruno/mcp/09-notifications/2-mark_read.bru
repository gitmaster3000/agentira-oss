meta {
  name: Mark Notification Read
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 81,
    "method": "tools/call",
    "params": {
      "name": "mark_notification_read",
      "arguments": {
        "notification_id": "nonexistent"
      }
    }
  }
}

tests {
  test("Mark notification read responds without crash", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result).to.be.an('object');
  });
}
