meta {
  name: Login
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 10,
    "method": "tools/call",
    "params": {
      "name": "login",
      "arguments": {
        "name": "admin",
        "password": "admin"
      }
    }
  }
}

tests {
  test("Login endpoint responds with result", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result).to.be.an('object');
    expect(res.body.result.content).to.be.an('array');
  });
}
