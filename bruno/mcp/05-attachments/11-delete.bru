meta {
  name: "20-Delete Attachment"
  type: "http"
  seq: 11
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 20,
    "method": "tools/call",
    "params": {
      "name": "delete_attachment",
      "arguments": {
        "attachment_id": "{{taskAttachmentId}}"
      }
    }
  }
}

tests {
  test("Delete attachment succeeds", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result.content[0].text).to.contain("true");
  });
}
