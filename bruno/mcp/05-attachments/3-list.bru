meta {
  name: "15-List Attachments"
  type: "http"
  seq: 3
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 15,
    "method": "tools/call",
    "params": {
      "name": "list_attachments",
      "arguments": {
        "task_id": "{{attachTaskId}}"
      }
    }
  }
}

tests {
  test("List attachments successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result).to.be.an('object');
  });

  test("Response contains content array", function() {
    const content = res.body.result.content;
    expect(content).to.be.an('array');
  });
}
