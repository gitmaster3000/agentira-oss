meta {
  name: "19-Read Epic Attachment Scope"
  type: "http"
  seq: 10
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 19,
    "method": "tools/call",
    "params": {
      "name": "read_attachment",
      "arguments": {
        "epic_id": "{{attachEpicId}}"
      }
    }
  }
}

tests {
  test("Epic scope lists its attachment", function() {
    expect(res.status).to.equal(200);
    const rows = res.body.result.content.map(item => JSON.parse(item.text));
    expect(rows[0].id).to.equal(bru.getVar("epicAttachmentId"));
    expect(rows[0].epic_id).to.equal(bru.getVar("attachEpicId"));
  });
}
