meta {
  name: Get Project Activity
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
  const pid = bru.getVar("projectId");
  req.setBody({
    jsonrpc: "2.0",
    id: 53,
    method: "tools/call",
    params: {
      name: "get_project_activity",
      arguments: { project_id: pid }
    }
  });
}

body:json {
  {}
}

tests {
  test("Get project activity returns list", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result).to.be.an('object');
    expect(res.body.result.isError).to.not.equal(true);
  });
}
