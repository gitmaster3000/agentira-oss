meta {
  name: Create Project
  type: "http"
  seq: 1
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 3,
    "method": "tools/call",
    "params": {
      "name": "create_project",
      "arguments": {
        "name": "Integration Test Project",
        "description": "Created via Bruno"
      }
    }
  }
}

script:post-response {
  if (res.body.result && res.body.result.content && res.body.result.content[0].text) {
     try {
       const text = res.body.result.content[0].text.replace(/'/g, '"');
       const data = JSON.parse(text);
       if (data && data.id) {
         bru.setVar("projectId", data.id);
       }
     } catch (e) {
       // Handle case where text is already a string representation or similar
     }
  }
}

tests {
  test("Create project successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result.content[0].text).to.contain("Integration Test Project");
  });
}
