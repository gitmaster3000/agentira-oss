meta {
  name: Delete Doomed Project
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
  const pid = bru.getVar("doomedProjectId");
  req.setBody({
    jsonrpc: "2.0",
    id: 103,
    method: "tools/call",
    params: {
      name: "delete_project",
      arguments: { project_id: pid }
    }
  });
}

body:json {
  {}
}

tests {
  test("Delete returned true", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result.content[0].text).to.contain("true");
  });
}
