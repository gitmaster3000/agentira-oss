meta {
  name: Create Doomed Project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 101,
    "method": "tools/call",
    "params": {
      "name": "create_project",
      "arguments": {
        "name": "Cascade Delete Project",
        "description": "Throwaway project to verify cascade delete"
      }
    }
  }
}

script:post-response {
  if (res.body.result && res.body.result.content && res.body.result.content[0].text) {
    try {
      const text = res.body.result.content[0].text.replace(/'/g, '"');
      const data = JSON.parse(text);
      if (data && data.id) {
        bru.setVar("doomedProjectId", data.id);
      }
    } catch (e) {
    }
  }
}

tests {
  test("Doomed project created", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result.content[0].text).to.contain("Cascade Delete Project");
  });
}
