meta {
  name: Remove Member
  type: "http"
  seq: 1
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 6,
    "method": "tools/call",
    "params": {
      "name": "remove_project_member",
      "arguments": {
        "project_id": "{{projectId}}",
        "profile_name": "{{myProfileName}}"
      }
    }
  }
}

tests {
  test("Remove project member successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result.content[0].text).to.contain("true");
  });
}
