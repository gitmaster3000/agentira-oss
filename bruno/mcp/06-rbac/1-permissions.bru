meta {
  name: "13-List Permissions"
  type: "http"
  seq: 1
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 13,
    "method": "tools/call",
    "params": {
      "name": "list_permissions",
      "arguments": {}
    }
  }
}

tests {
  test("List permissions successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result).to.be.an('object');
  });

  test("Response contains permissions list", function() {
    const content = res.body.result.content;
    expect(content).to.be.an('array');
    expect(content.length).to.be.greaterThan(0);
  });

  test("transition:* permission is present", function() {
    const allText = res.body.result.content.map(c => c.text).join('\n');
    expect(allText).to.contain('transition:*');
  });

  test("task.create permission is present", function() {
    const allText = res.body.result.content.map(c => c.text).join('\n');
    expect(allText).to.contain('task.create');
  });
}
