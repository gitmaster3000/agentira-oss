meta {
  name: "14-List Roles"
  type: "http"
  seq: 2
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: bearer
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getEnvVar("apiKey"));
  req.setHeader("mcp-session-id", bru.getVar("sessionId"));
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 14,
    "method": "tools/call",
    "params": {
      "name": "list_roles",
      "arguments": {}
    }
  }
}

tests {
  test("List roles successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body.result).to.be.an('object');
  });

  test("Response contains roles list", function() {
    const content = res.body.result.content;
    expect(content).to.be.an('array');
    expect(content.length).to.be.greaterThan(0);
  });

  test("admin role is present", function() {
    const allText = res.body.result.content.map(c => c.text).join('\n');
    expect(allText).to.contain('admin');
  });

  test("member role is present", function() {
    const allText = res.body.result.content.map(c => c.text).join('\n');
    expect(allText).to.contain('member');
  });

  test("viewer role is present", function() {
    const allText = res.body.result.content.map(c => c.text).join('\n');
    expect(allText).to.contain('viewer');
  });
}
