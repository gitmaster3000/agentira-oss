meta {
  name: Get Roadmap Data
  type: http
  seq: 20
}

get {
  url: {{base_url}}/api/projects/{{new_project_id}}/roadmap
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body[0].title: eq "Task with Start/Due Dates"
  res.body[0].start: eq "2026-04-01T00:00:00+00:00"
  res.body[0].end: eq "2026-04-15T00:00:00+00:00"
}