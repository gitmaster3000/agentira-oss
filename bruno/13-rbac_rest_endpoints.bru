meta {
  name: "13-RBAC REST Endpoints"
  type: "http"
  seq: 13
}

get {
  url: {{baseUrl}}/api/permissions
  body: none
  auth: none
}

tests {
  test("GET /api/permissions returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Permissions is a non-empty array", function() {
    expect(res.body).to.be.an('array');
    expect(res.body.length).to.be.greaterThan(0);
  });

  test("Each permission has id, codename, description", function() {
    res.body.forEach(function(p) {
      expect(p).to.have.property('id');
      expect(p).to.have.property('codename');
      expect(p).to.have.property('description');
    });
  });

  test("transition:* permission exists", function() {
    const codenames = res.body.map(p => p.codename);
    expect(codenames).to.include('transition:*');
  });

  test("task.create permission exists", function() {
    const codenames = res.body.map(p => p.codename);
    expect(codenames).to.include('task.create');
  });
}
