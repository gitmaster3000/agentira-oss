# Generic env example.
# Copy to .env.qa or .env.prod and fill in real values for those environments.
# Do NOT commit .env.qa or .env.prod — they're gitignored.
#
# Dev does not need an .env file: docker-compose.override.yml has
# everything hard-coded (intentionally — dev creds aren't secrets).

# ── Required everywhere except dev ─────────────────────────────────────
# 32-byte hex string. Generate: `openssl rand -hex 32`
JWT_SECRET=

# Postgres password for the bundled postgres service. Generate a strong one.
POSTGRES_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────
# OAuth client ids/secrets (leave empty to disable that provider).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# Frontend public port (prod only). Default 80; set 443 + a reverse proxy
# for TLS, or any other port if running behind a load balancer.
FRONTEND_PORT=80
