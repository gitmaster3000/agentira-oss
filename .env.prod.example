# Production environment example.
# Copy to .env.prod and fill in. .env.prod is gitignored — never commit it.
#
# In a real deployment, prefer your platform's secret store
# (Railway secrets, AWS Secrets Manager, etc.) over a file on disk.

# REQUIRED. 32-byte hex string. `openssl rand -hex 32`
JWT_SECRET=

# REQUIRED. Postgres password.
POSTGRES_PASSWORD=

# OAuth providers (set the ones you actually want to enable).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# Frontend public port. 80 for HTTP, or run behind a TLS-terminating LB.
FRONTEND_PORT=80
