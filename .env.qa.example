# QA environment example.
# Copy to .env.qa and fill in. .env.qa is gitignored.

# Required. Generate: `openssl rand -hex 32`
JWT_SECRET=replace-me-with-32-byte-hex

# Required. Postgres password for the bundled postgres service.
POSTGRES_PASSWORD=replace-me-with-strong-password

# Optional OAuth (leave empty to disable).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
